{
  "name": "@gridset/sdk",
  "version": "0.1.0",
  "description": "JavaScript/TypeScript client library for the GRIDSET Protocol smart contracts",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "keywords": [
    "gridset",
    "energy",
    "blockchain",
    "ethereum",
    "web3",
    "defi"
  ],
  "license": "MIT",
  "peerDependencies": {
    "ethers": "^6.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "ethers": "^6.0.0"
  }
}
